# Wajib. Tanpa ini server menolak start (fail closed).
# Buat nilai acak: openssl rand -hex 32
SIDECAR_TOKEN=ganti-dengan-token-acak-panjang

# Railway menyuntik PORT sendiri; hanya dipakai kalau jalan manual.
# PORT=8080
# SIDECAR_HOST=0.0.0.0

# Host yang boleh diresolusi (dipisah koma). Batasi supaya layanan ini tidak
# menjadi browser gratis untuk siapa pun.
# ALLOWED_HOSTS=kuramanime.run,kuramanime.xyz,kuramanime.blog

# Browser
# HEADLESS=true
# BROWSER_CHANNEL=
# SIDECAR_UA=

# Waktu (ms)
# NAV_TIMEOUT_MS=30000
# PLAYER_TIMEOUT_MS=25000
